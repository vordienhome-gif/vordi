<a class="skip" href="#main">Перейти к содержанию</a>
<header class="header">
  <div class="wrap header__in">
    <button type="button" class="header__burger" data-vo-menu-open aria-label="Меню" aria-controls="vo-drawer" aria-expanded="false">{% include 'icon', icon: 'menu' %}</button>
    {% include 'logo' %}
    <div class="hcat" data-vo-dropdown>
      <a class="btn btn--primary hcat__btn" href="/collection/all" aria-haspopup="true">{% include 'icon', icon: 'menu' %}<span>Каталог</span></a>
      {%- if collections.all.subcollections.size > 0 -%}
      <div class="mega">
        <div class="mega__grid">
        {%- for c1 in collections.all.subcollections -%}{%- if c1.handle == 'new' or c1.handle == 'hits' -%}{%- continue -%}{%- endif -%}
          <div class="mega__col">
            <a class="mega__title" href="{{ c1.url }}">{{ c1.title }}</a>
            {%- for c2 in c1.subcollections limit: 8 -%}<a class="mega__link" href="{{ c2.url }}">{{ c2.title }}</a>{%- endfor -%}
          </div>
        {%- endfor -%}
        </div>
      </div>
      {%- endif -%}
    </div>
    <form class="search" action="{{ search_url | default: '/search' }}" method="get" role="search">
      <input class="search__input" type="search" name="q" value="{{ search.query | escape }}" placeholder="Искать товары" aria-label="Поиск по каталогу">
      <button class="search__btn" type="submit" aria-label="Найти">{% include 'icon', icon: 'search' %}</button>
    </form>
    <div class="header__actions">
      <a class="hicon" href="{% if client %}/client_account/orders{% else %}/client_account/login{% endif %}">{% include 'icon', icon: 'user' %}<span>{% if client %}Кабинет{% else %}Войти{% endif %}</span></a>
      {%- if vo_show -%}<a class="hicon" href="{{ cart_url | default: '/cart_items' }}">{% include 'icon', icon: 'cart' %}<span data-vo-cart-total>{{ cart.items_price | money }}</span></a>
      {%- elsif client == nil -%}<a class="btn btn--primary btn--sm" href="/page/stat-partnerom">Стать клиентом</a>{%- endif -%}
    </div>
  </div>
  <nav class="cats-nav" aria-label="Разделы каталога">
    <div class="wrap cats-nav__in">
      {%- for c1 in collections.all.subcollections -%}{%- if c1.handle == 'new' or c1.handle == 'hits' -%}{%- continue -%}{%- endif -%}<a class="cats-nav__link" href="{{ c1.url }}">{{ c1.title | downcase | capitalize }}</a>{%- endfor -%}
    </div>
  </nav>
</header>

{%- assign nav_items = 'Условия|/page/usloviya,Доставка|/page/dostavka,Оплата|/page/oplata,Дропшиппинг|/page/dropshipping,О компании|/page/o-kompanii,Блог|/blogs/blog,Контакты|/page/kontakty' | split: ',' -%}
<div class="drawer" id="vo-drawer" hidden>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="Меню">
    <div class="drawer__head">{% include 'logo' %}<button type="button" class="drawer__close" data-vo-menu-close aria-label="Закрыть">{% include 'icon', icon: 'close' %}</button></div>
    <div class="drawer__body">
      <a class="drawer__link drawer__link--strong" href="/collection/all">Весь каталог</a>
      {%- for c1 in collections.all.subcollections -%}{%- if c1.handle == 'new' or c1.handle == 'hits' -%}{%- continue -%}{%- endif -%}
        <details class="drawer__group">
          <summary>{{ c1.title | downcase | capitalize }}</summary>
          <a class="drawer__link" href="{{ c1.url }}">Все товары раздела</a>
          {%- for c2 in c1.subcollections -%}<a class="drawer__link" href="{{ c2.url }}">{{ c2.title }}</a>{%- endfor -%}
        </details>
      {%- endfor -%}
      <hr>
      {%- for it in nav_items -%}{%- assign p2 = it | split: '|' -%}<a class="drawer__link" href="{{ p2[1] }}">{{ p2[0] }}</a>{%- endfor -%}
      <a class="drawer__link" href="/page/prays-list">Прайс-лист</a>
    </div>
  </div>
</div>
