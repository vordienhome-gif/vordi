<script>
  window.VO = {
    state: "{{ vo_state }}",
    minOrder: {{ vo_min | default: 0 | plus: 0 }},
    cartTotal: {{ cart.items_price | default: 0 | plus: 0 }},
    metrika: {{ settings.yandex_metrika_id | strip | plus: 0 }},
    template: "{{ template }}"
  };
</script>
{%- comment -%}theme.js (CDN) в двух местах вызывает $(…) вместо $$(…) — без этой заглушки скрипт падал на каждой странице (не работали поля заявки «Компания/ИНН», минимальная сумма, вид каталога). В репозитории theme.js уже исправлен; заглушку можно убрать после его загрузки в тему.{%- endcomment -%}
<script>if(typeof window.$==='undefined'){window.$=function(s,c){return Array.prototype.slice.call((c||document).querySelectorAll(s));};}</script>
<script src="{{ 'theme.js' | asset_url }}" defer></script>
<script>
(function(){
  function fmt(n){n=Math.round(Number(n)||0);return String(n).replace(/\B(?=(\d{3})+(?!\d))/g,' ')+' ₽';}
  function toast(h,err){var t=document.querySelector('.toast');if(!t){t=document.createElement('div');t.className='toast';t.setAttribute('role','status');document.body.appendChild(t);}t.className='toast'+(err?' toast--error':'');t.innerHTML=h;t.hidden=false;clearTimeout(t._t);t._t=setTimeout(function(){t.hidden=true;},5000);}
  document.addEventListener('click',function(e){
    var b=e.target.closest ? e.target.closest('[data-vo-add]') : null; if(!b||b.disabled)return; e.preventDefault();
    if(b.getAttribute('data-vo-added')==='1'){location.href='/cart_items';return;}
    var csrf=document.querySelector('meta[name="csrf-token"]'); b.disabled=true;
    fetch('/cart_items.json',{method:'POST',credentials:'same-origin',headers:{'Accept':'application/json','Content-Type':'application/x-www-form-urlencoded; charset=UTF-8','X-CSRF-Token':csrf?csrf.content:''},body:'variant_ids['+encodeURIComponent(b.getAttribute('data-vo-add'))+']=1'})
    .then(function(r){if(!r.ok)throw new Error(r.status);return r.json();})
    .then(function(d){var t=d&&(d.items_price!=null?d.items_price:d.total_price);if(t!=null)document.querySelectorAll('[data-vo-cart-total]').forEach(function(x){x.textContent=fmt(t);});
      if(window.Cart&&typeof window.Cart.forceUpdate==='function'){try{window.Cart.forceUpdate();}catch(e2){}}
      b.setAttribute('data-vo-added','1');b.classList.add('is-added');b.textContent='В корзине';toast('Товар добавлен. <a href="/cart_items">Перейти в корзину</a>');})
    .catch(function(){toast('Не удалось добавить товар. Обновите страницу.',true);})
    .then(function(){b.disabled=false;});
  });
})();
</script>
{%- if settings.yandex_metrika_id != blank -%}
<script>
  (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");
  ym({{ settings.yandex_metrika_id | strip }}, "init", {clickmap:true, trackLinks:true, accurateTrackBounce:true, webvisor:true, ecommerce:"dataLayer"});
</script>
{%- endif -%}
