{%- comment -%}Стили Elitmosteks Pro. Встроены в страницу: медиафайлы темы попадают в CDN с задержкой.{%- endcomment -%}
<style>
/* Elitmosteks Pro — шапка, главная и доработки карточек. Подключается после theme.css и extra.css. */

:root {
  --navy: #14213A;
  --navy-2: #1D2C4A;
  --gold: #B8925A;
  --shadow-lg: 0 18px 48px rgba(20, 33, 58, .14);
}

/* Верхняя строка */
.topbar { background: var(--navy); }
.topbar__in { min-height: 38px; }
.topbar__item, .topbar__link { gap: 7px; }
.topbar .ico { width: 15px; height: 15px; opacity: .8; }
.topbar__muted { color: #9FA8BA; }
.topbar__phone { font-weight: 600; color: #fff; }

/* Шапка */
.header { box-shadow: 0 1px 0 var(--line), 0 6px 18px rgba(20, 33, 58, .04); border-bottom: 0; }
.header__in { flex-wrap: nowrap; min-height: 76px; gap: 20px; }
.header .logo { flex: none; }
.hcat { position: static; flex: none; }
.hcat__btn { min-height: 46px; padding: 0 18px; }
.header .mega { top: 100%; }
.hcat:hover .mega, .hcat:focus-within .mega { display: block; }
.hcat .mega::before { content: ""; position: absolute; left: 0; right: 0; top: -12px; height: 12px; }
.search { flex: 1 1 auto; max-width: none; border-radius: 10px; background: #FBF9F5; }
.search__input, .search__btn { min-height: 46px; }
.header__actions { flex: none; gap: 4px; margin-left: 0; }
.hact { display: inline-flex; align-items: center; gap: 10px; padding: 6px 10px; border-radius: 10px; color: var(--ink); line-height: 1.2; }
.hact:hover { background: var(--surface-2); color: var(--ink); text-decoration: none; }
.hact .ico { color: var(--blue); }
.hact__text { display: flex; flex-direction: column; }
.hact__text b { font-size: 14px; font-weight: 600; }
.hact__text small { font-size: 12px; color: var(--muted); max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-variant-numeric: tabular-nums; }

/* Разделы под шапкой */
.cats-nav { border-top: 1px solid var(--line-2); background: #fff; }
.cats-nav__in { display: flex; align-items: center; gap: 2px; min-height: 46px; overflow-x: auto; scrollbar-width: none; }
.cats-nav__in::-webkit-scrollbar { display: none; }
.cats-nav__link { display: inline-flex; align-items: center; padding: 7px 12px; border-radius: 8px; color: var(--ink-2); font-weight: 500; font-size: 14px; white-space: nowrap; }
.cats-nav__link:hover, .cats-nav__link.is-active { background: var(--surface-2); color: var(--ink); text-decoration: none; }
.cats-nav__link--accent { margin-left: auto; color: var(--blue); font-weight: 600; }
.cats-nav__link--accent:hover { background: var(--blue-soft); color: var(--blue-dark); }

@media (max-width: 1100px) {
  .hact__text { display: none; }
  .hact { padding: 10px; }
}
@media (max-width: 900px) {
  .header__in { flex-wrap: wrap; min-height: 60px; gap: 10px 12px; }
  .hcat { display: none; }
  .header .logo { flex: 1; min-width: 0; }
  .hact--price { display: none; }
  .hact--cart { position: relative; }
  .search { order: 5; flex-basis: 100%; }
}

/* Общие элементы */
.eyebrow { margin-bottom: 6px; }
.eyebrow--light { color: #9DB8DD; }
.link-arrow { font-weight: 600; white-space: nowrap; }
.section { padding-top: 48px; }
.section__head { align-items: flex-end; margin-bottom: 20px; }
.section__title { font-size: 28px; letter-spacing: -.015em; }
@media (max-width: 640px) { .section { padding-top: 36px; } .section__title { font-size: 22px; } }

/* Первый экран */
.hero2 { background: radial-gradient(1200px 500px at 85% 0%, #fff 0%, rgba(255,255,255,0) 70%), var(--bg); border-bottom: 1px solid var(--line); overflow: hidden; }
.hero2__in { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px; align-items: center; padding-top: 56px; padding-bottom: 56px; }
.hero2__title { font-size: 48px; line-height: 1.08; font-weight: 700; letter-spacing: -.025em; margin: 0 0 18px; color: var(--navy); }
.hero2__lead { font-size: 17px; color: var(--ink-2); margin: 0 0 28px; max-width: 580px; }
.hero2__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 36px; }
.hero2__facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--line); }
.hero2__facts li { padding: 16px 16px 0 0; display: flex; flex-direction: column; gap: 2px; }
.hero2__facts li + li { padding-left: 16px; border-left: 1px solid var(--line); }
.hero2__facts b { font-size: 20px; color: var(--navy); font-variant-numeric: tabular-nums; white-space: nowrap; }
.hero2__facts span { font-size: 13px; color: var(--muted); line-height: 1.35; }
.hero2__media { position: relative; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 14px; height: 460px; }
.hero2__img { width: 100%; height: 100%; object-fit: cover; border-radius: 16px; box-shadow: var(--shadow-lg); background: var(--surface-2); }
.hero2__img--1 { grid-row: span 2; }
.hero2__badge { position: absolute; left: -22px; bottom: 28px; background: var(--navy); color: #fff; padding: 14px 18px; border-radius: 12px; box-shadow: var(--shadow-lg); display: flex; flex-direction: column; }
.hero2__badge b { font-size: 15px; }
.hero2__badge span { font-size: 13px; color: #C9D2E3; }
@media (max-width: 1100px) { .hero2__title { font-size: 40px; } .hero2__facts { grid-template-columns: 1fr 1fr; } .hero2__facts li:nth-child(3) { padding-left: 0; border-left: 0; } }
@media (max-width: 900px) {
  .hero2__in { grid-template-columns: minmax(0, 1fr); padding-top: 32px; padding-bottom: 32px; gap: 28px; }
  .hero2__media { height: 300px; }
  .hero2__badge { left: 12px; bottom: 12px; }
}
@media (max-width: 640px) {
  .hero2__title { font-size: 31px; }
  .hero2__lead { font-size: 16px; }
  .hero2__cta .btn { flex: 1 1 100%; }
  .hero2__media { height: 240px; gap: 8px; }
  .hero2__facts b { font-size: 17px; white-space: normal; }
}

/* Полоса преимуществ */
.trust { background: #fff; border-bottom: 1px solid var(--line); }
.trust__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
.trust__item { display: flex; gap: 14px; align-items: flex-start; padding: 24px 20px; }
.trust__item + .trust__item { border-left: 1px solid var(--line-2); }
.trust__item .ico { width: 26px; height: 26px; color: var(--blue); flex: none; margin-top: 2px; }
.trust__item b { display: block; font-size: 15px; color: var(--navy); }
.trust__item span { display: block; font-size: 13px; color: var(--muted); margin-top: 2px; }
@media (max-width: 1000px) { .trust__grid { grid-template-columns: 1fr 1fr; } .trust__item:nth-child(3) { border-left: 0; } .trust__item:nth-child(n+3) { border-top: 1px solid var(--line-2); } }
@media (max-width: 560px) { .trust__grid { grid-template-columns: 1fr; } .trust__item + .trust__item { border-left: 0; border-top: 1px solid var(--line-2); } .trust__item { padding: 16px 0; } }

/* Разделы каталога */
.cats2 { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
.cat2 { position: relative; display: block; aspect-ratio: 1; border-radius: 14px; overflow: hidden; background: var(--surface-2); color: #fff; }
.cat2--wide { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; }
.cat2__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .45s ease; }
.cat2::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,33,58,0) 45%, rgba(20,33,58,.78) 100%); }
.cat2:hover { text-decoration: none; color: #fff; }
.cat2:hover .cat2__img { transform: scale(1.05); }
.cat2__body { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: 14px 16px; display: flex; flex-direction: column; }
.cat2__title { font-weight: 700; font-size: 17px; line-height: 1.2; }
.cat2--wide .cat2__title { font-size: 26px; }
.cat2__count { font-size: 13px; color: #DCE3EF; }
@media (max-width: 1100px) { .cats2 { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
@media (max-width: 760px) { .cats2 { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } .cat2--wide { grid-column: span 2; grid-row: auto; aspect-ratio: 2 / 1; } .cat2__title { font-size: 15px; } .cat2--wide .cat2__title { font-size: 20px; } }

/* Карточка товара */
.pcard { border-radius: 14px; border-color: var(--line-2); }
.pcard:hover { box-shadow: var(--shadow-lg); border-color: var(--line); }
.pcard__img { aspect-ratio: 4 / 5; }
.pcard__body { padding: 14px; }
.pcard__price b { font-size: 18px; color: var(--navy); }
.pcard__price s { margin-left: 8px; color: var(--muted); font-weight: 400; font-size: 13px; }
.pcard__ask { font-size: 14px; color: var(--blue); }
.pcard__stock { color: var(--green); display: inline-flex; align-items: center; gap: 6px; }
.pcard__stock::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.pcard__title { min-height: 3.9em; }
.pcard__badge { position: absolute; left: 10px; top: 10px; background: var(--navy); color: #fff; font-size: 12px; font-weight: 600; padding: 4px 8px; border-radius: 6px; }
.pcard__badge--sale { background: var(--red); }

/* Кому подходит */
.segments2 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.segment2 { background: #fff; border: 1px solid var(--line-2); border-radius: 14px; padding: 24px; display: flex; flex-direction: column; gap: 8px; color: var(--ink-2); transition: box-shadow .2s, border-color .2s; }
.segment2:hover { text-decoration: none; color: var(--ink-2); box-shadow: var(--shadow-lg); border-color: var(--line); }
.segment2 b { font-size: 18px; color: var(--navy); }
.segment2 span { font-size: 14px; }
.segment2__ico { width: 48px; height: 48px; border-radius: 12px; background: var(--blue-soft); color: var(--blue); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 6px; }
.segment2__ico .ico { width: 24px; height: 24px; }
.segment2 .segment2__more { margin-top: auto; padding-top: 8px; color: var(--blue); font-weight: 600; }
@media (max-width: 900px) { .segments2 { grid-template-columns: minmax(0, 1fr); } }

/* Как заказать */
.howto { background: var(--navy); color: #DCE3EF; margin-top: 56px; padding: 56px 0; }
.howto .section__title { color: #fff; }
.howto__list { list-style: none; counter-reset: h; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
.howto__list li { counter-increment: h; background: var(--navy-2); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 6px; }
.howto__list li::before { content: "0" counter(h); font-size: 14px; font-weight: 700; color: var(--gold); letter-spacing: .08em; margin-bottom: 6px; }
.howto__list b { color: #fff; font-size: 17px; }
.howto__list span { font-size: 14px; color: #B9C3D6; }
.howto__cta { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; margin-top: 28px; }
.howto__link { color: #fff; font-weight: 600; }
.howto__link:hover { color: #fff; }
@media (max-width: 1000px) { .howto__list { grid-template-columns: 1fr 1fr; } }
@media (max-width: 560px) { .howto__list { grid-template-columns: minmax(0, 1fr); } .howto { padding: 40px 0; } }

/* Бренды */
.brands2 { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
.brand2 { display: flex; align-items: center; justify-content: center; min-height: 72px; padding: 10px; text-align: center; background: #fff; border: 1px solid var(--line-2); border-radius: 12px; color: var(--navy); font-weight: 700; font-size: 16px; letter-spacing: .02em; }
.brand2:hover { border-color: var(--blue); color: var(--blue); text-decoration: none; }
@media (max-width: 900px) { .brands2 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 560px) { .brands2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } .brand2 { min-height: 56px; font-size: 14px; } }

/* Прайс-лист */
.cta2 { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); border-radius: 18px; overflow: hidden; box-shadow: var(--shadow-lg); }
.cta2__text { background: var(--blue); color: #DCE6F3; padding: 40px; }
.cta2__title { color: #fff; font-size: 30px; line-height: 1.15; letter-spacing: -.015em; margin: 0 0 14px; }
.cta2__list { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-direction: column; gap: 10px; }
.cta2__list li { display: flex; gap: 10px; align-items: center; color: #fff; }
.cta2__list .ico { color: #9DB8DD; }
.cta2__form { background: #fff; padding: 32px 40px; }
.cta2__form .lead { margin-top: 0; }
@media (max-width: 900px) { .cta2 { grid-template-columns: minmax(0, 1fr); } .cta2__text, .cta2__form { padding: 28px 20px; } .cta2__title { font-size: 24px; } }

/* О компании */
.about2 { background: #fff; border: 1px solid var(--line-2); border-radius: 14px; padding: 32px; color: var(--ink-2); }
.about2 .section__title { font-size: 22px; margin-bottom: 12px; color: var(--navy); }
.about2 p { margin: 0 0 10px; max-width: 900px; }
@media (max-width: 640px) { .about2 { padding: 20px; } }

/* Подвал */
.footer { background: var(--navy); margin-top: 56px; }
.footer__bottom { border-top-color: rgba(255,255,255,.1); }

/* Мобильные: окно cookie и кнопка менеджера не перекрывают контент */
@media (max-width: 640px) { .cookie { bottom: 12px; } }

.hero2__note { margin: -20px 0 28px; font-size: 14px; color: var(--muted); }
.hact__join { min-height: 44px; margin-left: 6px; }
@media (max-width: 640px) { .hact__join { min-height: 38px; padding: 0 12px; font-size: 14px; } }
.gate { border-radius: 12px; }
@media (max-width: 560px) {
  .hact--user { display: none; }
  .header .logo { overflow: hidden; }
}
</style>
