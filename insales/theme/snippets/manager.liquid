{%- comment -%}Кнопка «Связаться с оптовым менеджером»{%- endcomment -%}
{%- assign tg = settings.telegram | remove: '@' | strip -%}
{%- assign wa = settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
{%- assign m_phone = settings.manager_phone | default: settings.phone -%}
{%- assign m_phone_link = m_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
<div class="mgr" data-vo-manager>
  <div class="mgr__panel" id="vo-mgr-panel" hidden>
    <div class="mgr__head">
      <b>Оптовый отдел</b>
      <span>{% if settings.manager_name != blank %}Ваш менеджер: {{ settings.manager_name }}{% else %}Ответим в рабочее время{% endif %}</span>
    </div>
    {%- if tg != blank -%}<a class="mgr__item" href="https://t.me/{{ tg }}" target="_blank" rel="noopener">{% include 'icon', icon_name: 'telegram' %} Написать в Telegram</a>{%- endif -%}
    {%- if wa != blank -%}<a class="mgr__item" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{% include 'icon', icon_name: 'whatsapp' %} Написать в WhatsApp</a>{%- endif -%}
    {% include 'messengers', mx_style: 'mgr' %}
    {%- if m_phone != blank -%}<a class="mgr__item" href="tel:{{ m_phone_link }}">{% include 'icon', icon_name: 'phone' %} {{ m_phone }}</a>{%- endif -%}
    {%- if settings.email != blank -%}<a class="mgr__item" href="mailto:{{ settings.email }}">{% include 'icon', icon_name: 'mail' %} {{ settings.email }}</a>{%- endif -%}
    <a class="mgr__item" href="/page/kontakty#form">{% include 'icon', icon_name: 'chat' %} Оставить сообщение</a>
  </div>
  <button type="button" class="mgr__btn" data-vo-manager-toggle aria-expanded="false" aria-controls="vo-mgr-panel">
    {% include 'icon', icon_name: 'chat' %}<span>Связаться с менеджером</span>
  </button>
</div>
