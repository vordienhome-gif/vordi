{%- include 'vo-access' -%}
{%- comment -%}Главная в стиле маркетплейса: короткий баннер, разделы, полки товаров, весь ассортимент.{%- endcomment -%}
<section class="wrap promo">
  <div class="promo__in">
    <div class="promo__text">
      <h1 class="promo__title">{{ settings.hero_title | default: 'Турецкий домашний текстиль оптом' }}</h1>
      <p class="promo__lead">{% if vo_show %}Ваши оптовые цены и остатки — в каталоге.{% else %}Оптовые цены открываются после подтверждения компании.{% endif %} Доставка по Москве и МО бесплатно{% if vo_min > 0 %}, заказ от {{ vo_min | money }}{% endif %}.</p>
    </div>
    {%- if vo_show or vo_state == 'pending' -%}<a class="btn btn--light btn--lg" href="/collection/all">Смотреть каталог</a>{%- else -%}<a class="btn btn--light btn--lg" href="/page/stat-partnerom">Стать оптовым клиентом</a>{%- endif -%}
  </div>
</section>

<section class="wrap section">
  <div class="cats">
    {%- for c1 in collections.all.subcollections -%}{%- if c1.handle == 'new' or c1.handle == 'hits' -%}{%- continue -%}{%- endif -%}
      {%- assign c1_img = nil -%}
      {%- if c1.image -%}{%- unless c1.image.large_url contains 'no_image' -%}{%- assign c1_img = c1.image | image_url: 320, format: 'webp' -%}{%- endunless -%}{%- endif -%}
      {%- if c1_img == nil -%}{%- for p in c1.products limit: 4 -%}{%- if c1_img == nil and p.images.size > 0 -%}{%- assign c1_img = p.first_image | image_url: 320, format: 'webp' -%}{%- endif -%}{%- endfor -%}{%- endif -%}
      <a class="cat" href="{{ c1.url }}">
        {%- if c1_img -%}<img class="cat__img" src="{{ c1_img }}" alt="" loading="lazy" decoding="async" width="160" height="160">{%- else -%}<span class="cat__img cat__img--empty"></span>{%- endif -%}
        <span class="cat__title">{{ c1.title | downcase | capitalize }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% include 'product-shelf', shelf_collection: collections.new, shelf_title: 'Новинки', shelf_limit: 10 %}
{% include 'product-shelf', shelf_collection: collections.hits, shelf_title: 'Хиты продаж', shelf_limit: 10 %}

<section class="wrap section">
  <div class="section__head"><h2 class="section__title">Все товары</h2><a href="/collection/all">Весь каталог →</a></div>
  <div class="pgrid pgrid--catalog">
    {%- assign shown = 0 -%}
    {%- for card_product in collections.all.products -%}
      {%- if shown < 20 and card_product.available and card_product.images.size > 0 -%}{% include 'product-card' %}{%- assign shown = shown | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
  </div>
  <div class="more"><a class="btn btn--soft btn--lg" href="/collection/all">Показать все товары</a></div>
</section>
