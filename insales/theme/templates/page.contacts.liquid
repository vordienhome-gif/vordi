{%- include 'vo-access' -%}
<div class="wrap">{% include 'breadcrumbs' %}</div>
<div class="wrap page page--form">
  <article class="page__body">
    <h1 class="page-title">{{ page.title }}</h1>
    {% include 'contact-cards' %}
    {% include 'map' %}
    {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}
    <h2 class="block__title">Написать оптовому менеджеру</h2>
    {% include 'lead-form', form_kind: 'contact' %}
  </article>
  <aside class="page__side">{% include 'side-info' %}</aside>
</div>
